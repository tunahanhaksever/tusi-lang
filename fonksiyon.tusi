// 🇹🇷 Tusi v4.0 — Fonksiyonlar & Özyineleme (Recursion)

fonksiyon fibonacci(n) {
  eğer (n <= 1) ise {
    döndür n
  }
  döndür fibonacci(n - 1) + fibonacci(n - 2)
}

fonksiyon faktoriyel(n) {
  eğer (n <= 1) ise {
    döndür 1
  }
  döndür n * faktoriyel(n - 1)
}

yazdır("5! Faktöriyel Hesabı:", faktoriyel(5))
yazdır("Fibonacci(10):", fibonacci(10))

yazdır("Karekök(144):", Matematik.karekök(144))
yazdır("2^8 Üs Hesabı:", Matematik.üs(2, 8))
