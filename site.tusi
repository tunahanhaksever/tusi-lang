fonksiyon ana_sayfa(istek, yanit) {
    yazdır("Yeni bir ziyaretçi geldi! Yol: " + istek["yol"])

    // Başlık ve CSS ekleyelim (Modern bir görünüm için)
    yanit_yaz(yanit, "<html><head><meta charset='utf-8'><title>Tusi Web Sitesi</title>")
    yanit_yaz(yanit, "<style>body{font-family: 'Segoe UI', sans-serif; background: #f0f2f5; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0;}")
    yanit_yaz(yanit, ".card{background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 10px 20px rgba(0,0,0,0.1); text-align: center; border-left: 5px solid #007bff;}")
    yanit_yaz(yanit, "h1{color: #333;} p{color: #666;} .footer{margin-top: 1rem; font-size: 0.8rem; color: #aaa;}</style></head><body>")

    yanit_yaz(yanit, "<div class='card'>")
    yanit_yaz(yanit, "<h1>🐟 Tusi Dünyasına Hoş Geldiniz!</h1>")
    yanit_yaz(yanit, "<p>Bu site tamamen <b>Tusi</b> programlama dili ile oluşturuldu.</p>")
    
    değişken zaman = zaman_simdi()
    yanit_yaz(yanit, "<p>Sunucu saati: " + zaman + "</p>")
    
    eğer (istek["yol"] == "/hakkimizda") ise {
        yanit_yaz(yanit, "<p><b>Hakkımızda:</b> Tusi, geleceğin Türkçesi, kodun gücüdür.</p>")
    } değilse {
        yanit_yaz(yanit, "<p><a href='/hakkimizda'>Hakkımızda sayfasına git</a></p>")
    }

    yanit_yaz(yanit, "<div class='footer'>Tusi v1.2 | Gelişmiş Web Motoru</div>")
    yanit_yaz(yanit, "</div></body></html>")
    
    yanit_bitir(yanit)
}

// 8080 portunda sunucuyu başlatalım
yazdır("Web sunucusu başlatılıyor...")
sunucu_baslat(8080, ana_sayfa)
